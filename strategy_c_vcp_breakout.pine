//@version=6
strategy("VCP Breakout C", overlay = true, initial_capital = 10000,
     process_orders_on_close = false)

// ---------------- Inputs (minimal by design) ----------------
volMultiplier = input.float(1.4, "Breakout Volume Multiplier", minval = 1.0, group = "Entry")
riskPct       = input.float(1.0, "Risk % of Equity per Trade", minval = 0.1, group = "Risk")

// ---------------- Hardcoded, research-backed constants ----------------
adxLen       = 14
adxThreshold = 20.0
kamaErPeriod = 10
atrLen       = 14
stopAtrMult  = 1.5
trailAtrMult = 3.0
trailActivateAtrMult = 1.0
pivotLen     = 3
staleWindow  = 60
volAvgLen    = 50
maxSwings    = 5
kamaFastLen  = 2
kamaSlowLen  = 30

// ---------------- Indicators ----------------
// Kaufman's Adaptive Moving Average (no built-in ta.kama in Pine v6)
kamaFastSC = 2.0 / (kamaFastLen + 1)
kamaSlowSC = 2.0 / (kamaSlowLen + 1)
kamaChange = math.abs(close - close[kamaErPeriod])
kamaVolatility = math.sum(math.abs(close - close[1]), kamaErPeriod)
kamaER = kamaVolatility != 0 ? kamaChange / kamaVolatility : 0.0
kamaSC = math.pow(kamaER * (kamaFastSC - kamaSlowSC) + kamaSlowSC, 2)
var float kama = na
kama := na(kama[1]) ? close : kama[1] + kamaSC * (close - kama[1])

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
atr = ta.atr(atrLen)
volAvg = ta.sma(volume, volAvgLen)

// ---------------- Regime gate ----------------
regimeOk = adx > adxThreshold and diPlus > diMinus and close > kama

// ---------------- Swing pivot tracking ----------------
var swingHighArr = array.new_float(0)
var swingLowArr  = array.new_float(0)
var depthArr     = array.new_float(0)
var depthBarArr  = array.new_int(0)

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

if not na(ph)
    array.push(swingHighArr, ph)
    if array.size(swingHighArr) > maxSwings
        array.shift(swingHighArr)

if not na(pl)
    if array.size(swingHighArr) > 0
        recentHigh = array.get(swingHighArr, array.size(swingHighArr) - 1)
        depth = (recentHigh - pl) / recentHigh
        array.push(depthArr, depth)
        array.push(depthBarArr, bar_index - pivotLen)
        if array.size(depthArr) > maxSwings
            array.shift(depthArr)
            array.shift(depthBarArr)
    array.push(swingLowArr, pl)
    if array.size(swingLowArr) > maxSwings
        array.shift(swingLowArr)

// ---------------- VCP contraction check ----------------
contracting = false
patternBar  = int(na)
if array.size(depthArr) >= 3
    n = array.size(depthArr)
    d1 = array.get(depthArr, n - 3)
    d2 = array.get(depthArr, n - 2)
    d3 = array.get(depthArr, n - 1)
    contracting := d3 < d2 and d2 < d1
    patternBar  := array.get(depthBarArr, n - 1)

patternFresh = not na(patternBar) and (bar_index - patternBar) <= staleWindow

contractionHigh = array.size(swingHighArr) > 0 ? array.get(swingHighArr, array.size(swingHighArr) - 1) : na
contractionLow  = array.size(swingLowArr)  > 0 ? array.get(swingLowArr,  array.size(swingLowArr)  - 1) : na

// ---------------- Entry trigger: volume-confirmed breakout ----------------
volumeConfirmed = volume >= volMultiplier * volAvg
breakout = not na(contractionHigh) and ta.crossover(close, contractionHigh)
longSignal = regimeOk and contracting and patternFresh and breakout and volumeConfirmed

// ---------------- Position sizing (risk-based) ----------------
stopDistance = stopAtrMult * atr
riskQty = stopDistance > 0 ? (strategy.equity * riskPct / 100) / stopDistance : na

if longSignal and not na(riskQty)
    strategy.entry("Long", strategy.long, qty = riskQty)

// ---------------- Exit logic ----------------
var float stopPrice        = na
var float highSinceEntry   = na
var float entryContractionLow = na

if strategy.position_size > 0 and strategy.position_size[1] == 0
    stopPrice := close - stopAtrMult * atr
    highSinceEntry := high
    entryContractionLow := contractionLow

if strategy.position_size > 0
    highSinceEntry := math.max(nz(highSinceEntry), high)
    entryPrice = strategy.position_avg_price
    inProfitForTrail = (close - entryPrice) >= trailActivateAtrMult * atr
    if inProfitForTrail
        chandelier = highSinceEntry - trailAtrMult * atr
        stopPrice := math.max(stopPrice, chandelier)
else
    stopPrice := na
    highSinceEntry := na
    entryContractionLow := na

patternBreak = strategy.position_size > 0 and not na(entryContractionLow) and close < entryContractionLow

if strategy.position_size > 0
    strategy.exit("Exit", "Long", stop = stopPrice)
    if patternBreak
        strategy.close("Long", comment = "Pattern break")

// ---------------- Plots ----------------
plot(kama, "KAMA", color = color.new(color.blue, 0), linewidth = 2)
plot(contractionHigh, "Contraction High", color = color.new(color.orange, 0), style = plot.style_circles)
plot(strategy.position_size > 0 ? stopPrice : na, "Stop", color = color.new(color.purple, 0),
     style = plot.style_circles, linewidth = 1)

plotshape(longSignal, title = "Long Signal", style = shape.triangleup,
     location = location.belowbar, color = color.new(color.green, 0), size = size.small)

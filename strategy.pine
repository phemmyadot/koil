//@version=6
strategy("Trend Pullback Strategy v1", overlay = true, initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     process_orders_on_close = true)

// ---------------- Inputs ----------------
emaFastLen  = input.int(20,  "EMA Fast (pullback level)", group = "Trend")
emaMidLen   = input.int(50,  "EMA Mid (trend break exit)", group = "Trend")
emaSlowLen  = input.int(200, "EMA Slow (regime filter)",   group = "Trend")
slopeLookback = input.int(20, "EMA Slow slope lookback bars", group = "Trend")

rsiLen       = input.int(14, "RSI Length", group = "Entry")
rsiThreshold = input.float(45, "RSI Resume Threshold", group = "Entry")

atrLen        = input.int(14, "ATR Length", group = "Exit")
stopAtrMult   = input.float(1.5, "Initial Stop (x ATR)", group = "Exit")
trailAtrMult  = input.float(3.0, "Trail Stop (x ATR)", group = "Exit")
trailActivateAtrMult = input.float(1.0, "Trail Activation (x ATR profit)", group = "Exit")

// ---------------- Indicators ----------------
emaFast = ta.ema(close, emaFastLen)
emaMid  = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi     = ta.rsi(close, rsiLen)
atr     = ta.atr(atrLen)

// ---------------- Regime filter ----------------
slowRising   = emaSlow > emaSlow[slopeLookback]
aboveSlow    = close > emaSlow
midAboveSlow = emaMid > emaSlow
inUptrend    = slowRising and aboveSlow and midAboveSlow

// ---------------- Entry trigger: pullback + RSI resume ----------------
pulledBack = low <= emaFast and close > emaMid
rsiResume  = ta.crossover(rsi, rsiThreshold)
longSignal = inUptrend and pulledBack and rsiResume

// signal fires on this bar's close, order fills next bar open (default strategy behavior)
if longSignal
    strategy.entry("Long", strategy.long)

// ---------------- Exit logic ----------------
var float stopPrice      = na
var float highSinceEntry = na

if strategy.position_size > 0 and strategy.position_size[1] == 0
    // just entered this bar
    stopPrice := close - stopAtrMult * atr
    highSinceEntry := high

if strategy.position_size > 0
    highSinceEntry := math.max(nz(highSinceEntry), high)
    entryPrice = strategy.position_avg_price
    inProfitForTrail = (close - entryPrice) >= trailActivateAtrMult * atr
    if inProfitForTrail
        chandelier = highSinceEntry - trailAtrMult * atr
        stopPrice := math.max(stopPrice, chandelier)
else
    stopPrice := na
    highSinceEntry := na

trendBreak = strategy.position_size > 0 and close < emaMid

if strategy.position_size > 0
    strategy.exit("Exit", "Long", stop = stopPrice)
    if trendBreak
        strategy.close("Long", comment = "Trend break")

// ---------------- Plots ----------------
plot(emaFast, "EMA 20", color = color.new(color.blue, 0), linewidth = 1)
plot(emaMid,  "EMA 50", color = color.new(color.orange, 0), linewidth = 1)
plot(emaSlow, "EMA 200", color = color.new(color.red, 0), linewidth = 2)
plot(strategy.position_size > 0 ? stopPrice : na, "Stop", color = color.new(color.purple, 0),
     style = plot.style_circles, linewidth = 1)

plotshape(longSignal, title = "Long Signal", style = shape.triangleup,
     location = location.belowbar, color = color.new(color.green, 0), size = size.small)

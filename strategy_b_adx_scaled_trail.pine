//@version=6
strategy("Adaptive Pullback B (ADX-Scaled Trail)", overlay = true, initial_capital = 10000,
     process_orders_on_close = false)

// ---------------- Inputs (minimal by design) ----------------
erPeriod = input.int(10, "KAMA Efficiency Ratio Period", minval = 2, group = "Trend")
riskPct  = input.float(1.0, "Risk % of Equity per Trade", minval = 0.1, group = "Risk")

// ---------------- Hardcoded, research-backed constants ----------------
adxLen        = 14
adxThreshold  = 20.0
rsiLen        = 14
rsiSignalLen  = 9
atrLen        = 14
stopAtrMult   = 1.5
trailActivateAtrMult = 1.0
pullbackAtrBuffer    = 0.5
trailMultFloor   = 2.5
trailMultCeiling = 4.5
trailMultScale   = 20.0
kamaFastLen   = 2
kamaSlowLen   = 30
slowErMult        = 3
extensionLookback = 10
extensionAtrMult  = 1.0

// ---------------- Indicators ----------------
// Kaufman's Adaptive Moving Average (no built-in ta.kama in Pine v6)
kamaFastSC = 2.0 / (kamaFastLen + 1)
kamaSlowSC = 2.0 / (kamaSlowLen + 1)
kamaChange = math.abs(close - close[erPeriod])
kamaVolatility = math.sum(math.abs(close - close[1]), erPeriod)
kamaER = kamaVolatility != 0 ? kamaChange / kamaVolatility : 0.0
kamaSC = math.pow(kamaER * (kamaFastSC - kamaSlowSC) + kamaSlowSC, 2)
var float kama = na
kama := na(kama[1]) ? close : kama[1] + kamaSC * (close - kama[1])

// Slower KAMA (longer efficiency-ratio window) used only for the trend-break
// exit -- validated against real AAL/F/PLTR data that using the fast entry line
// for the exit too causes premature exits within 5-7 bars of entry, before
// trades have room to develop into real winners.
slowErPeriod = erPeriod * slowErMult
slowKamaChange = math.abs(close - close[slowErPeriod])
slowKamaVolatility = math.sum(math.abs(close - close[1]), slowErPeriod)
slowKamaER = slowKamaVolatility != 0 ? slowKamaChange / slowKamaVolatility : 0.0
slowKamaSC = math.pow(slowKamaER * (kamaFastSC - kamaSlowSC) + kamaSlowSC, 2)
var float slowKama = na
slowKama := na(slowKama[1]) ? close : slowKama[1] + slowKamaSC * (close - slowKama[1])

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
rsi       = ta.rsi(close, rsiLen)
rsiSignal = ta.sma(rsi, rsiSignalLen)
atr       = ta.atr(atrLen)

// ---------------- Regime gate ----------------
regimeOk = adx > adxThreshold and diPlus > diMinus

// ---------------- Entry trigger: adaptive pullback + RSI resume ----------------
// extendedRecently requires a genuine prior rally away from KAMA before a touch
// counts as a "pullback" -- otherwise KAMA hugs price so closely in any grind
// that a bare touch condition fires on >25% of bars (validated against real data).
extDist = (close - kama) / atr
extendedRecently = ta.highest(extDist[1], extensionLookback) >= extensionAtrMult
pulledBack = low <= kama and close > (kama - pullbackAtrBuffer * atr) and extendedRecently
rsiResume  = ta.crossover(rsi, rsiSignal)
longSignal = regimeOk and pulledBack and rsiResume

// ---------------- Position sizing (risk-based) ----------------
stopDistance = stopAtrMult * atr
riskQty = stopDistance > 0 ? (strategy.equity * riskPct / 100) / stopDistance : na

if longSignal and not na(riskQty)
    strategy.entry("Long", strategy.long, qty = riskQty)

// ---------------- Exit logic: ADX-scaled Chandelier trail ----------------
var float stopPrice      = na
var float highSinceEntry = na

if strategy.position_size > 0 and strategy.position_size[1] == 0
    stopPrice := close - stopAtrMult * atr
    highSinceEntry := high

if strategy.position_size > 0
    highSinceEntry := math.max(nz(highSinceEntry), high)
    entryPrice = strategy.position_avg_price
    inProfitForTrail = (close - entryPrice) >= trailActivateAtrMult * atr
    if inProfitForTrail
        trailMult  = math.max(trailMultFloor, math.min(trailMultCeiling, trailMultFloor + (adx - adxThreshold) / trailMultScale))
        chandelier = highSinceEntry - trailMult * atr
        stopPrice := math.max(stopPrice, chandelier)
else
    stopPrice := na
    highSinceEntry := na

trendBreak = strategy.position_size > 0 and close < slowKama

if strategy.position_size > 0
    strategy.exit("Exit", "Long", stop = stopPrice)
    if trendBreak
        strategy.close("Long", comment = "Trend break")

// ---------------- Plots ----------------
plot(kama, "KAMA (fast, entry)", color = color.new(color.blue, 0), linewidth = 2)
plot(slowKama, "KAMA (slow, trend-break exit)", color = color.new(color.teal, 0), linewidth = 2)
plot(adx, "ADX", color = color.new(color.gray, 0), display = display.data_window)
plot(strategy.position_size > 0 ? stopPrice : na, "Stop", color = color.new(color.purple, 0),
     style = plot.style_circles, linewidth = 1)

plotshape(longSignal, title = "Long Signal", style = shape.triangleup,
     location = location.belowbar, color = color.new(color.green, 0), size = size.small)

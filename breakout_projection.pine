//@version=6
indicator("Ultimate Pre-Breakout Scorer & Target Projector", overlay=true, max_labels_count=500)

// ==========================================
// USER INPUTS
// ==========================================
bbLength     = input.int(20, title="Bollinger Band Length", group="Volatility Settings")
bbMult       = input.float(2.0, title="BB StdDev Multiplier", group="Volatility Settings")
sqzLookback  = input.int(50, title="Squeeze Historical Base", group="Volatility Settings")

volLength    = input.int(20, title="Volume MA Length", group="Volume Settings")
volThreshold = input.float(0.85, title="Volume Dry-up Threshold", group="Volume Settings")

resLength    = input.int(20, title="Resistance Lookback Period", group="Structure Settings")
proxThreshold= input.float(2.5, title="Proximity to Resistance (%)", group="Structure Settings")
trendLength  = input.int(50, title="Trend EMA Length", group="Structure Settings")

// ==========================================
// METRIC CALCULATIONS
// ==========================================
// 1. Volatility Compression (Bollinger Band Width Squeeze)
basis = ta.sma(close, bbLength)
dev = bbMult * ta.stdev(close, bbLength)
upper = basis + dev
lower = basis - dev
bbWidth = (upper - lower) / basis
bbSqueeze = bbWidth < ta.sma(bbWidth, sqzLookback) 

// 2. Volume Dry-Up
volMA = ta.sma(volume, volLength)
volDryUp = volume < (volMA * volThreshold)

// 3. Tight Clustering Near Resistance
resHigh = ta.highest(high, resLength)[1] // Exclude current bar to monitor true breakout
resLow  = ta.lowest(low, resLength)[1]
pctFromResistance = ((resHigh - close) / close) * 100
nearResistance = pctFromResistance <= proxThreshold and pctFromResistance >= 0

// 4. Trend Baseline
emaTrend = ta.ema(close, trendLength)
isBullishTrend = close > emaTrend
isBearishTrend = close < emaTrend

// 5. Breakout Engine
isBreakout = ta.crossover(close, resHigh) and volume > volMA * 1.25

// ==========================================
// CAUSE & EFFECT TRACKING (DURATION & TARGETS)
// ==========================================
var int squeezeCounter = 0
var float projectedTarget = na
var int projectedDuration = na
var int breakoutBarIndex = na
var float breakoutLevel = na  // the resistance level AT the breakout, fixed -- resHigh itself
                               // keeps rolling forward as new highs form, so it can't be used
                               // to check "did price fail and fall back below the breakout"

// Count how long the market has been compressing. Requires BOTH a volatility squeeze AND
// proximity to resistance together (not just either alone), otherwise the counter can
// accumulate credit from unrelated conditions in different volatility regimes.
if bbSqueeze and nearResistance
    squeezeCounter := squeezeCounter + 1
else if not isBullishTrend
    squeezeCounter := 0 // Reset if trend fails

// On active breakout, lock in the mathematical targets
if isBreakout
    baseDepth = resHigh - resLow
    projectedTarget := resHigh + baseDepth // 1:1 Measured Move Target
    // Expected bull duration is ~75% of base building time, floored at resLength: requiring
    // squeeze AND near-resistance simultaneously (see above) means squeezeCounter is 0 at the
    // moment of breakout ~86% of the time (volatility is, by definition, already expanding as
    // price crosses resistance) -- an unfloored duration collapses to 0 bars, which immediately
    // invalidates the target on the very next bar regardless of any other fix.
    projectedDuration := math.max(int(squeezeCounter * 0.75), resLength)
    breakoutBarIndex := bar_index
    breakoutLevel := resHigh
    squeezeCounter := 0 // reset so a later, unrelated breakout doesn't inherit a stale count

// Manage target rendering timeout: clear if trend fails, price closes meaningfully back below
// the breakout level (failed breakout, with a small buffer so an ordinary 1-bar retest/
// throwback doesn't kill an otherwise-valid breakout), or the expected duration has elapsed
// without resolving.
// (The original check used ta.change(resHigh) != 0, which fires almost immediately after
// every breakout as the new high rolls into the lookback window -- the target line could
// never survive past the breakout bar itself.)
durationElapsed = not na(breakoutBarIndex) and not na(projectedDuration) and
     (bar_index - breakoutBarIndex) > projectedDuration
failedBreakout = not na(breakoutLevel) and close < breakoutLevel * 0.985
if close < emaTrend or failedBreakout or durationElapsed
    projectedTarget := na
    projectedDuration := na
    breakoutBarIndex := na
    breakoutLevel := na

// ==========================================
// STATE SCORING LOGIC
// ==========================================
string state = "NEUTRAL"
color stateColor = color.gray
int score = 0

if isBearishTrend
    state := "BEARISH"
    stateColor := color.red
    score := -2
else if isBreakout
    state := "BREAKOUT"
    stateColor := color.green
    score := 5
else if bbSqueeze and volDryUp and nearResistance and isBullishTrend
    state := "PRE-BREAKOUT"
    stateColor := color.orange
    score := 4
else if bbSqueeze and isBullishTrend
    state := "COILING (BULL)"
    stateColor := color.yellow
    score := 2
else if isBullishTrend
    state := "BULLISH"
    stateColor := color.blue
    score := 1

// ==========================================
// VISUAL RENDERING
// ==========================================
// 1. Shaded Background Signals
bgcolor(state == "PRE-BREAKOUT" ? color.new(color.orange, 88) : state == "BREAKOUT" ? color.new(color.green, 85) : na)

// 2. Structural Lines
plot(resHigh, title="Key Resistance Line", color=color.new(color.red, 40), linewidth=1, style=plot.style_line)
plot(emaTrend, title="Trend Baseline (EMA)", color=color.blue, linewidth=2, style=plot.style_line)

// 3. Dynamic Measured Move Target Line
plot(projectedTarget, title="Breakout Target", color=color.new(color.green, 20), linewidth=2, style=plot.style_line)

// 4. On-Chart Dashboard HUD
var table db = table.new(position.bottom_left, 2, 7, bgcolor=color.new(color.black, 15), border_color=color.gray, border_width=1)
if barstate.islast
    // Headers
    table.cell(db, 0, 0, "Signal Metric", text_color=color.white, bgcolor=color.gray, text_size = 10)
    table.cell(db, 1, 0, "Condition Status", text_color=color.white, bgcolor=color.gray, text_size = 10)
    
    // Rows
    table.cell(db, 0, 1, "Market Phase Score", text_color=color.white, text_size = 10)
    table.cell(db, 1, 1, state + " (" + str.tostring(score) + ")", text_color=color.white, bgcolor=stateColor, text_size = 10)
    
    table.cell(db, 0, 2, "Volatility Squeeze", text_color=color.white, text_size = 10)
    table.cell(db, 1, 2, bbSqueeze ? "COMPRESSED" : "EXPANDED", text_color=color.white, bgcolor=bbSqueeze ? color.orange : color.teal, text_size = 10)
    
    table.cell(db, 0, 3, "Volume Dry-up", text_color=color.white, text_size = 10)
    table.cell(db, 1, 3, volDryUp ? "DRY (NO SELLERS)" : "NORMAL/HIGH", text_color=color.white, bgcolor=volDryUp ? color.orange : color.teal, text_size = 10)
    
    table.cell(db, 0, 4, "Clustering At Ceiling", text_color=color.white, text_size = 10)
    table.cell(db, 1, 4, nearResistance ? "YES (COILING)" : "NO", text_color=color.white, bgcolor=nearResistance ? color.orange : color.teal, text_size = 10)

    table.cell(db, 0, 5, "Trend Filter", text_color=color.white, text_size = 10)
    table.cell(db, 1, 5, isBullishTrend ? "BULLISH" : "BEARISH", text_color=color.white, bgcolor=isBullishTrend ? color.blue : color.red, text_size = 10)
    
    table.cell(db, 0, 6, "Coil Energy Build-up", text_color=color.white, text_size = 10)
    table.cell(db, 1, 6, str.tostring(squeezeCounter) + " Bars", text_color=color.white, bgcolor=squeezeCounter > 30 ? color.purple : color.maroon, text_size = 10)

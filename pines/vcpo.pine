//@version=6
strategy("VCPO", overlay=true, initial_capital=1500, default_qty_type=strategy.percent_of_equity, default_qty_value=33.33, calc_on_every_tick=true)

// ==========================================
// USER INPUTS & PARAMETERS (Fallback Defaults)
// ==========================================
var string G_DATE   = "Stage 0b: Backtest Date Range"
var string G_ENTRY  = "Stage 1: Adaptive Entry Settings"
var string G_TRAIL  = "Stage 4: Multi-Tier Risk & Protection"
var string G_TIME   = "Stage 5: Intelligent Time Stop"
var string G_DTE    = "Stage 6: DTE Elapsed Flag (visual only)"

// Stage 0b Inputs - Date Filter
bool use_date_filter = input.bool(false, title="Restrict Backtest to Date Range", group=G_DATE)
int start_date        = input.time(timestamp("2022-01-01 00:00"), title="Start Date", group=G_DATE)
int end_date           = input.time(timestamp("2069-12-31 00:00"), title="End Date", group=G_DATE)
bool in_date_range     = not use_date_filter or (time >= start_date and time <= end_date)

// Stage 1 Inputs - Validated Ranges
int atr_len         = input.int(22, title="Manual ATR Length", group=G_ENTRY, minval=5, maxval=35, step=1)
float atr_mult      = input.float(3.0, title="Manual ATR Stop Multiplier", group=G_ENTRY, step=0.1, minval=1.0, maxval=5.0)

// Stage 4 Inputs - Hardcoded Safety Margins
float be_trigger    = input.float(7.9, title="Breakeven Activation Tier (%)", group=G_TRAIL, step=0.1, minval=5.0, maxval=10.0)
float trail_tier    = input.float(13.1, title="Aggressive Trail Tier (%)", group=G_TRAIL, step=0.1, minval=8.0, maxval=15.0)
float tp_target     = input.float(11.0, title="Manual Take Profit Target (%)", group=G_TRAIL, step=1.0, minval=5.0, maxval=25.0)
string stop_style   = input.string("Dynamic ATR", title="Stop Style Profile", options=["Dynamic ATR", "Static %"], group=G_TRAIL)

// Stage 5 Inputs - Inactivity Parameters
bool use_time       = input.bool(true, title="Enable Inactivity Time Stop", group=G_TIME)
int max_bars        = input.int(20, title="Max Bars to Stagnancy Check", group=G_TIME, step=1, minval=5, maxval=20)

// Visual-only: flags N candles after EVERY entry, independent of the actual
// time stop above -- lets you eyeball where each trade would be on a fixed
// DTE clock without changing strategy behavior.
bool show_dte_flag = input.bool(true, title="Show DTE Elapsed Flag", group=G_DTE)
int dte_bars        = input.int(20, title="DTE (candles)", group=G_DTE, minval=1, maxval=500)


// ==========================================
// SYSTEM INDICATORS & RE-SCALING ENGINE
// ==========================================
float atr_value          = ta.atr(atr_len)
float historical_atr_avg = ta.sma(atr_value, 100)

float macro_base_filter  = ta.ema(close, 50)
bool macro_trend_bullish = close > macro_base_filter


// ==========================================
// STAGE 1: ADAPTIVE VCP BREAKOUT DETECTION
// ==========================================
bool asset_is_compressed = atr_value <= (historical_atr_avg * 1.15)
float local_resistance   = ta.highest(high, 20)[1]
bool breakout_triggered  = close > local_resistance and asset_is_compressed


// ==========================================
// EXECUTION & POSITION TRACKING STATE
// ==========================================
var float entry_price  = na
var float stop_price   = na
var bool be_activated  = false
var bool tp_half_hit   = false
var int bars_in_trade  = 0

// Visual-only DTE tracking: one entry per trade taken, independent of the
// per-position state above. Pruned once an entry ages past dte_bars so the
// array can't grow unbounded over a long backtest.
var int[] dte_entry_bars = array.new_int(0)

if (strategy.position_size > 0)
    bars_in_trade := bars_in_trade + 1
    if na(entry_price)
        entry_price := strategy.opentrades.entry_price(0)
        stop_price  := entry_price - (atr_value * atr_mult)
else
    entry_price      := na
    stop_price       := na
    be_activated     := false
    tp_half_hit      := false
    bars_in_trade    := 0

bool entry_signal = (breakout_triggered and strategy.position_size == 0) and in_date_range
if entry_signal
    strategy.entry("Long", strategy.long, comment="Long")
    array.push(dte_entry_bars, bar_index)


// ==========================================
// STAGE 4: UPGRADED MULTI-TIER TRADE MANAGEMENT
// ==========================================
var float high_since_entry = na
if (strategy.position_size > 0)
    if na(high_since_entry)
        high_since_entry := high
    else
        high_since_entry := math.max(high_since_entry, high)
        
    float max_gain_pct = ((high_since_entry - entry_price) / entry_price) * 100
    
    if (max_gain_pct >= be_trigger and not be_activated)
        stop_price   := entry_price
        be_activated := true

    if (stop_style == "Dynamic ATR")
        if (tp_half_hit or max_gain_pct >= trail_tier)
            stop_price := math.max(stop_price, close - (atr_value * 2.5))
        else if (be_activated)
            stop_price := math.max(stop_price, math.max(entry_price, close - (atr_value * 4.5)))
        else
            stop_price := math.max(stop_price, entry_price - (atr_value * atr_mult))
    else
        if (max_gain_pct >= trail_tier or tp_half_hit)
            stop_price := math.max(stop_price, entry_price * (1 + (trail_tier * 0.005)))

    if (max_gain_pct >= tp_target and not tp_half_hit)
        strategy.order("TP Half", strategy.short, qty=strategy.position_size * 0.5, comment="TP Half")
        tp_half_hit := true

    if (close < stop_price or low < stop_price)
        strategy.close("Long", comment="Ladder Floor Hit")
else
    high_since_entry := na


// ==========================================
// STAGE 5: MACRO TREND INACTIVITY OVERRIDE
// ==========================================
if (use_time and (bars_in_trade >= max_bars))
    if (close <= entry_price and not macro_trend_bullish)
        strategy.close("Long", comment="Time Stop: Stagnant")


// ==========================================
// VISUAL DIAGNOSTICS
// ==========================================

// DTE Elapsed Flag: visual-only marker, N candles after each entry above
if show_dte_flag and array.size(dte_entry_bars) > 0
    for i = array.size(dte_entry_bars) - 1 to 0
        age = bar_index - array.get(dte_entry_bars, i)
        if age == dte_bars
            label.new(bar_index, high, text="DTE", style=label.style_label_down,
                 color=color.new(color.maroon, 0), textcolor=color.white, size=size.small)
        if age > dte_bars
            array.remove(dte_entry_bars, i)

plot(strategy.position_size > 0 ? entry_price : na, color=color.maroon, style=plot.style_linebr, linestyle = plot.linestyle_dashed, linewidth=1, title="Execution Baseline")


plotshape(entry_signal, title = "Long Signal", style = shape.triangleup,
     location = location.belowbar, color = color.new(color.maroon, 0), size = size.small)

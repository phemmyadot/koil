//@version=6
strategy("VEXH", 
     overlay=true, 
     initial_capital=10000, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=35, // 35% allocation; chosen from 5-99% sweep (best profit vs tail risk; worst trade ~-21% = ~-7.6% equity)
     commission_type=strategy.commission.percent, 
     commission_value=0.1,
     process_orders_on_close=true)

// --- Strategy Inputs ---
// Bounds reflect the validated ranges from the 2022-2024 / 2025-2026 train-test sweeps;
// defaults are the best gate-passing values as of 2026-07.
smaSlowLen = input.int(150, title="Macro SMA Length", minval=100, maxval=200, step=25)
bbLen      = input.int(20, title="Bollinger Band Length", minval=15, maxval=25)
bbMult     = input.float(1.5, title="Bollinger Band Multiplier", minval=1.25, maxval=2.0, step=0.25)
rsiLen     = input.int(14, title="RSI Length", minval=7, maxval=21)
rsiLower   = input.float(40.0, title="RSI Exhaustion Threshold", minval=35, maxval=45, step=1)
timeStopBars = input.int(20, title="Time Stop (bars, 0 = off)", minval=0, maxval=30)
smaDistAtr   = input.float(0.5, title="Entry: Min ATR Distance Above SMA (0 = off)", minval=0, maxval=1.0, step=0.25)
atrPctMax    = input.float(12.0, title="Entry: Max ATR as % of Price (0 = off)", minval=0, maxval=16, step=1.0)
atrPctMin    = input.float(4.0, title="Entry: Min ATR as % of Price (0 = off)", minval=0, maxval=8, step=1.0)
startDate  = input.time(timestamp("1 Jan 2022 00:00 +0000"), title="Backtest Start")
endDate    = input.time(timestamp("1 Jan 2030 00:00 +0000"), title="Backtest End")

// Visual-only: flags N candles after EVERY entry, independent of the actual
// time stop above -- lets you eyeball where each trade would be on a fixed
// DTE clock without changing strategy behavior.
showDteFlag = input.bool(true, title="Show DTE Elapsed Flag (visual only)")
dteBars     = input.int(20, title="DTE (candles)", minval=1, maxval=500)

// --- Technical Indicators ---
macroSma = ta.sma(close, smaSlowLen)
bbBasis  = ta.sma(close, bbLen)
bbStd    = ta.stdev(close, bbLen)
bbLower  = bbBasis - (bbStd * bbMult)
atrVal   = ta.atr(14)

// Simple Rolling Mean RSI Math
delta = close - close[1]
gain  = delta > 0 ? delta : 0
loss  = delta < 0 ? -delta : 0
smaGain = ta.sma(gain, rsiLen)
smaLoss = ta.sma(loss, rsiLen)
rsiVal  = 100 - (100 / (1 + (smaGain / (smaLoss + 1e-9))))

// --- Strategy Conditions ---
hasEnoughData  = bar_index >= smaSlowLen
macroBullish   = close > macroSma
bbExhaustion   = close < bbLower
rsiWashedOut   = rsiVal <= rsiLower
smaDistOk      = smaDistAtr == 0 or close >= macroSma + smaDistAtr * atrVal
volCeilOk      = atrPctMax == 0 or (atrVal / close) * 100 <= atrPctMax
volFloorOk     = atrPctMin == 0 or (atrVal / close) * 100 >= atrPctMin
inWindow       = time >= startDate and time <= endDate

entryCondition = hasEnoughData and macroBullish and bbExhaustion and rsiWashedOut and smaDistOk and volCeilOk and volFloorOk and inWindow

// --- State Machine Tracking ---
var float targetMid  = na
var int   entryBar   = na
var float entryPrice = na

// Visual-only DTE tracking: one entry per trade taken, independent of the
// single-slot entryBar above (which the real time stop overwrites on the
// next trade). Pruned once an entry ages past dteBars so the array can't
// grow unbounded over a long backtest. dteEntryPrices is parallel to
// dteEntryBars (same index = same trade) so the % move since entry can be
// shown alongside the flag.
var int[]   dteEntryBars   = array.new_int(0)
var float[] dteEntryPrices = array.new_float(0)

// Running DTE-result stats (summary only, no per-trade list)
var int   dteCount        = 0
var int   dteWinCount     = 0
var int   dteLossCount    = 0
var float dtePctWinSum    = 0.0
var float dtePctLossSum   = 0.0

// 1. Invalidation Stop: trend break below the macro floor closes the trade
if (strategy.position_size > 0 and close < macroSma)
    strategy.close("Exhaustion_Long", comment="Stop: Trend Break")

// 2. Time Stop: reversion thesis dead if TP not reached within N bars
if (strategy.position_size > 0 and timeStopBars > 0 and bar_index - entryBar >= timeStopBars)
    strategy.close("Exhaustion_Long", comment="Stop: Time")

// 3. Entry on Close; take-profit as a resting limit at the frozen mid-band
entrySignal = strategy.position_size == 0 and entryCondition
if entrySignal
    targetMid  := bbBasis
    entryBar   := bar_index
    entryPrice := close
    strategy.entry("Exhaustion_Long", strategy.long, comment="Enter Position")
    strategy.exit("TP Reversion", "Exhaustion_Long", limit=targetMid)
    array.push(dteEntryBars, bar_index)
    array.push(dteEntryPrices, close)

// 4. DTE Elapsed Flag: visual-only marker, N candles after each entry above,
// labeled with the % move from that entry's price to now
if showDteFlag and array.size(dteEntryBars) > 0
    for i = array.size(dteEntryBars) - 1 to 0
        age = bar_index - array.get(dteEntryBars, i)
        if age == dteBars
            float dtePct = (close - array.get(dteEntryPrices, i)) / array.get(dteEntryPrices, i) * 100
            label.new(bar_index, high, text="DTE\n" + str.tostring(dtePct, "#.#") + "%",
                 style=label.style_label_down, color=color.new(color.purple, 0), textcolor=color.white, size=size.small)
            dteCount += 1
            if dtePct > 0
                dteWinCount  += 1
                dtePctWinSum += dtePct
            else
                dteLossCount  += 1
                dtePctLossSum += dtePct
        if age > dteBars
            array.remove(dteEntryBars, i)
            array.remove(dteEntryPrices, i)

// --- Visual Chart Layout ---
plotshape(entrySignal, title = "Long Signal", style = shape.triangleup,
     location = location.belowbar, color = color.new(color.purple, 0), size = size.small)
plot(strategy.position_size > 0 ? entryPrice : na, color=color.purple, style=plot.style_linebr, linestyle = plot.linestyle_dashed, linewidth=1, title="Execution Baseline")
plot(strategy.position_size > 0 ? macroSma : na, color=color.purple, style=plot.style_linebr, linewidth=1, title="Dynamic Tracking Floor")
plot(strategy.position_size > 0 ? targetMid : na, color=color.purple, style=plot.style_circles, linewidth=1, title="Take Profit")

var table dteTable = table.new(position.bottom_right, 2, 4, bgcolor=color.new(color.purple, 95), border_color=color.purple, border_width=1) // VEXH: bottom-right
if showDteFlag and barstate.islastconfirmedhistory
    float dteWinRate   = dteCount > 0 ? dteWinCount / float(dteCount) * 100 : 0.0
    float dteAvgPctWin = dteWinCount > 0 ? dtePctWinSum / dteWinCount : 0.0
    float dteAvgPctLoss = dteLossCount > 0 ? dtePctLossSum / dteLossCount : 0.0
    table.cell(dteTable, 0, 0, "Win Rate", text_color=color.purple, text_size=size.small)
    table.cell(dteTable, 1, 0, str.tostring(dteWinRate, "#.#") + "%", text_color=color.purple, text_size=size.small)
    table.cell(dteTable, 0, 1, "Avg P DTE %", text_color=color.purple, text_size=size.small)
    table.cell(dteTable, 1, 1, str.tostring(dteAvgPctWin, "#.#") + "%", text_color=color.purple, text_size=size.small)
    table.cell(dteTable, 0, 2, "Avg L DTE %", text_color=color.purple, text_size=size.small)
    table.cell(dteTable, 1, 2, str.tostring(dteAvgPctLoss, "#.#") + "%", text_color=color.purple, text_size=size.small)
    table.cell(dteTable, 0, 3, "Count", text_color=color.purple, text_size=size.small)
    table.cell(dteTable, 1, 3, str.tostring(dteCount), text_color=color.purple, text_size=size.small)

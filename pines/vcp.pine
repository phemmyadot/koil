//@version=6
strategy("VCP", overlay=true, initial_capital=1500, default_qty_type=strategy.percent_of_equity, default_qty_value=66.66, calc_on_every_tick=false)

// ==========================================
// USER INPUTS & PARAMETERS (Strict Institutional Bounds)
// ==========================================
var string G_DATE   = "Stage 0b: Backtest Date Range"
var string G_ENTRY  = "Stage 1: Adaptive Entry Settings"
var string G_TRAIL  = "Stage 4: Multi-Tier Risk & Protection"
var string G_TIME   = "Stage 5: Intelligent Time Stop"
var string G_DTE    = "Stage 6: DTE Elapsed Flag (visual only)"

// Stage 0b Inputs - Date Filter
bool use_date_filter = input.bool(true, title="Restrict Backtest to Date Range", group=G_DATE)
int start_date        = input.time(timestamp("1 Jan 2022 00:00 +0000"), title="Start Date", group=G_DATE)
int end_date           = input.time(timestamp("1 Jan 2030 00:00 +0000"), title="End Date", group=G_DATE)
bool in_date_range     = not use_date_filter or (time >= start_date and time <= end_date)

// Stage 1 Inputs - Validated Ranges
int atr_len         = input.int(22, title="ATR Length", group=G_ENTRY, minval=10, maxval=25, step=1)
float atr_mult      = input.float(3, title="Initial ATR Stop Multiplier", group=G_ENTRY, step=0.1, minval=1.0, maxval=3.0)
float vol_mult      = input.float(1.4, title="Breakout Volume Multiplier (x 50d avg)", group=G_ENTRY, step=0.1, minval=1.0, maxval=3.0)
float risk_pct      = input.float(1.0, title="Risk % of Equity per Trade", group=G_ENTRY, step=0.1, minval=0.1, maxval=5.0)

// Stage 4 Inputs - Hardcoded Safety Margins
float be_trigger    = input.float(7.9, title="Breakeven Activation Tier (%)", group=G_TRAIL, step=0.1, minval=5.0, maxval=10.0)
float trail_tier    = input.float(13.1, title="Aggressive Trail Tier (%)", group=G_TRAIL, step=0.1, minval=8.0, maxval=15.0)
float tp_target     = input.float(11, title="Partial Take Profit Target (%)", group=G_TRAIL, step=1.0, minval=10.0, maxval=20.0)
string stop_style   = input.string("Dynamic ATR", title="Stop Style Profile", options=["Dynamic ATR", "Static %"], group=G_TRAIL)

// Stage 5 Inputs - Inactivity Parameters
bool use_time       = input.bool(false, title="Enable Inactivity Time Stop", group=G_TIME)
int max_bars        = input.int(20, title="Max Bars to Stagnancy Check", group=G_TIME, step=1, minval=5, maxval=20)

// Visual-only: flags N candles after EVERY entry, independent of the actual
// time stop above -- lets you eyeball where each trade would be on a fixed
// DTE clock without changing strategy behavior.
bool show_dte_flag = input.bool(true, title="Show DTE Elapsed Flag", group=G_DTE)
int dte_bars        = input.int(20, title="DTE (candles)", group=G_DTE, minval=1, maxval=500)

// ==========================================
// SYSTEM INDICATORS & RE-SCALING ENGINE
// ==========================================
float atr_value          = ta.atr(atr_len)
float historical_atr_avg = ta.sma(atr_value, 100)

// Macro trend filter to preserve trades building institutional launchpads
float macro_base_filter  = ta.ema(close, 50)
bool macro_trend_bullish = close > macro_base_filter


// ==========================================
// STAGE 1: ADAPTIVE VCP BREAKOUT DETECTION
// ==========================================
bool asset_is_compressed = atr_value <= (historical_atr_avg * 1.15)
float local_resistance   = ta.highest(high, 20)[1]
// Volume confirmation: a breakout above the contraction high needs institutional
// participation behind it (Minervini's standard: 1.4x-2.0x the 50-day average
// volume), otherwise it's much more prone to failing/reversing.
float vol_avg_50         = ta.sma(volume, 50)
bool volume_confirmed    = volume >= vol_mult * vol_avg_50
bool breakout_triggered  = close > local_resistance and asset_is_compressed and volume_confirmed


// ==========================================
// EXECUTION & POSITION TRACKING STATE
// ==========================================
var float entry_price  = na
var float stop_price   = na
var bool be_activated  = false
var bool tp_half_hit   = false
var int bars_in_trade  = 0

// Visual-only DTE tracking: one entry per trade taken, independent of the
// per-position state above. Pruned once an entry ages past dte_bars so the
// array can't grow unbounded over a long backtest. dte_entry_prices is
// parallel to dte_entry_bars (same index = same trade) so the % move since
// entry can be shown alongside the flag.
var int[]   dte_entry_bars   = array.new_int(0)
var float[] dte_entry_prices = array.new_float(0)

// Running DTE-result stats (summary only, no per-trade list)
var int   dte_count         = 0
var int   dte_win_count     = 0
var int   dte_loss_count    = 0
var float dte_pct_win_sum   = 0.0
var float dte_pct_loss_sum  = 0.0

if (strategy.position_size > 0)
    bars_in_trade := bars_in_trade + 1
    if na(entry_price)
        entry_price := strategy.opentrades.entry_price(0)
        stop_price  := entry_price - (atr_value * atr_mult)
else
    entry_price      := na
    stop_price       := na
    be_activated     := false
    tp_half_hit      := false
    bars_in_trade    := 0

// Fire Strategy Entry Leg -- risk-based sizing: position size is derived from
// the actual stop distance (atr_value * atr_mult) so every trade risks the
// same % of equity regardless of how tight or wide that stock's ATR stop is,
// instead of a flat 66.66%-of-equity allocation that let a tight-stop trade
// and a wide-stop trade carry very different dollar risk for the same size.
float stop_distance = atr_value * atr_mult
float risk_qty       = stop_distance > 0 ? (strategy.equity * risk_pct / 100) / stop_distance : na

bool entry_signal = breakout_triggered and strategy.position_size == 0 and in_date_range and not na(risk_qty)
if entry_signal
    strategy.entry("Long", strategy.long, qty=risk_qty, comment="Long")
    array.push(dte_entry_bars, bar_index)
    array.push(dte_entry_prices, close)


// ==========================================
// STAGE 4: UPGRADED MULTI-TIER TRADE MANAGEMENT
// ==========================================
var float high_since_entry = na
if (strategy.position_size > 0)
    if na(high_since_entry)
        high_since_entry := high
    else
        high_since_entry := math.max(high_since_entry, high)
        
    float max_gain_pct = ((high_since_entry - entry_price) / entry_price) * 100
    
    // Tier 1: Early Breakeven Protection
    if (max_gain_pct >= be_trigger and not be_activated)
        stop_price   := entry_price
        be_activated := true

    // Tier 2: Dynamic Scaling Stop Floor
    if (stop_style == "Dynamic ATR")
        if (tp_half_hit or max_gain_pct >= trail_tier)
            stop_price := math.max(stop_price, close - (atr_value * 2.5))
        else if (be_activated)
            stop_price := math.max(stop_price, math.max(entry_price, close - (atr_value * 4.5)))
        else
            stop_price := math.max(stop_price, entry_price - (atr_value * atr_mult))
    else
        if (max_gain_pct >= trail_tier or tp_half_hit)
            stop_price := math.max(stop_price, entry_price * (1 + (trail_tier * 0.005)))

    // Partial Take Profit Execution
    if (max_gain_pct >= tp_target and not tp_half_hit)
        strategy.order("TP Half", strategy.short, qty=strategy.position_size * 0.5, comment="TP Half")
        tp_half_hit := true

    // Capital Exit Trigger
    if (close < stop_price or low < stop_price)
        strategy.close("Long", comment="Ladder Floor Hit")
else
    high_since_entry := na


// ==========================================
// STAGE 5: MACRO TREND INACTIVITY OVERRIDE
// ==========================================
if (use_time and (bars_in_trade >= max_bars))
    if (close <= entry_price and not macro_trend_bullish)
        strategy.close("Long", comment="Time Stop: Stagnant")


// ==========================================
// VISUAL DIAGNOSTICS
// ==========================================

// DTE Elapsed Flag: visual-only marker, N candles after each entry above,
// labeled with the % move from that entry's price to now
if show_dte_flag and array.size(dte_entry_bars) > 0
    for i = array.size(dte_entry_bars) - 1 to 0
        age = bar_index - array.get(dte_entry_bars, i)
        if age == dte_bars
            float dte_pct = (close - array.get(dte_entry_prices, i)) / array.get(dte_entry_prices, i) * 100
            label.new(bar_index, high, text="DTE\n" + str.tostring(dte_pct, "#.#") + "%",
                 style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.white, size=size.small)
            dte_count += 1
            if dte_pct > 0
                dte_win_count    += 1
                dte_pct_win_sum  += dte_pct
            else
                dte_loss_count   += 1
                dte_pct_loss_sum += dte_pct
        if age > dte_bars
            array.remove(dte_entry_bars, i)
            array.remove(dte_entry_prices, i)

plot(strategy.position_size > 0 ? entry_price : na, color=color.orange, style=plot.style_linebr, linestyle = plot.linestyle_dashed, linewidth=1, title="Execution Baseline")
plot(strategy.position_size > 0 ? stop_price : na, color=color.orange, style=plot.style_linebr, linewidth=1, title="Dynamic Tracking Floor")
plot(strategy.position_size > 0 ? entry_price * (1 + tp_target / 100) : na, color=color.orange, style=plot.style_circles, linewidth=1, title="Take Profit")

plotshape(entry_signal, title = "Long Signal", style = shape.triangleup,
     location = location.belowbar, color = color.new(color.orange, 0), size = size.small)

var table dte_table = table.new(position.bottom_center, 2, 4, bgcolor=color.new(color.orange, 95), border_color=color.orange, border_width=1) // VCP: bottom-center, avoids overlap with VEXH/VCPO if run together
if show_dte_flag and barstate.islastconfirmedhistory
    float dte_win_rate     = dte_count > 0 ? dte_win_count / float(dte_count) * 100 : 0.0
    float dte_avg_pct_win  = dte_win_count > 0 ? dte_pct_win_sum / dte_win_count : 0.0
    float dte_avg_pct_loss = dte_loss_count > 0 ? dte_pct_loss_sum / dte_loss_count : 0.0
    table.cell(dte_table, 0, 0, "Win Rate", text_color=color.orange, text_size=size.small)
    table.cell(dte_table, 1, 0, str.tostring(dte_win_rate, "#.#") + "%", text_color=color.orange, text_size=size.small)
    table.cell(dte_table, 0, 1, "Avg P DTE %", text_color=color.orange, text_size=size.small)
    table.cell(dte_table, 1, 1, str.tostring(dte_avg_pct_win, "#.#") + "%", text_color=color.orange, text_size=size.small)
    table.cell(dte_table, 0, 2, "Avg L DTE %", text_color=color.orange, text_size=size.small)
    table.cell(dte_table, 1, 2, str.tostring(dte_avg_pct_loss, "#.#") + "%", text_color=color.orange, text_size=size.small)
    table.cell(dte_table, 0, 3, "Count", text_color=color.orange, text_size=size.small)
    table.cell(dte_table, 1, 3, str.tostring(dte_count), text_color=color.orange, text_size=size.small)

//@version=5
strategy("Hardened Exhaustion Engine - Production 5% Sized", 
     overlay=true, 
     initial_capital=10000, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=15, // 15% allocation; loss tail capped by time stop + entry filter (worst trade ~-21% = ~-3.2% equity)
     commission_type=strategy.commission.percent, 
     commission_value=0.1,
     process_orders_on_close=true)

// --- Strategy Inputs (High-Yield Parameters) ---
smaSlowLen = input.int(150, title="Macro SMA Length")
bbLen      = input.int(20, title="Bollinger Band Length")
bbMult     = input.float(1.75, title="Bollinger Band Multiplier")
rsiLen     = input.int(14, title="RSI Length")
rsiLower   = input.float(40.0, title="RSI Exhaustion Threshold")
timeStopBars = input.int(20, title="Time Stop (bars, 0 = off)", minval=0)
smaDistAtr   = input.float(0.5, title="Entry: Min ATR Distance Above SMA (0 = off)", step=0.25, minval=0)
startDate  = input.time(timestamp("1 Jan 2022 00:00 +0000"), title="Backtest Start")
endDate    = input.time(timestamp("1 Jan 2030 00:00 +0000"), title="Backtest End")

// --- Technical Indicators ---
macroSma = ta.sma(close, smaSlowLen)
bbBasis  = ta.sma(close, bbLen)
bbStd    = ta.stdev(close, bbLen)
bbLower  = bbBasis - (bbStd * bbMult)
atrVal   = ta.atr(14)

// Simple Rolling Mean RSI Math
delta = close - close[1]
gain  = delta > 0 ? delta : 0
loss  = delta < 0 ? -delta : 0
smaGain = ta.sma(gain, rsiLen)
smaLoss = ta.sma(loss, rsiLen)
rsiVal  = 100 - (100 / (1 + (smaGain / (smaLoss + 1e-9))))

// --- Strategy Conditions ---
hasEnoughData  = bar_index >= smaSlowLen
macroBullish   = close > macroSma
bbExhaustion   = close < bbLower
rsiWashedOut   = rsiVal <= rsiLower
smaDistOk      = smaDistAtr == 0 or close >= macroSma + smaDistAtr * atrVal
inWindow       = time >= startDate and time <= endDate

entryCondition = hasEnoughData and macroBullish and bbExhaustion and rsiWashedOut and smaDistOk and inWindow

// --- State Machine Tracking ---
var float targetMid = na
var int   entryBar  = na

// 1. Invalidation Stop: trend break below the macro floor closes the trade
if (strategy.position_size > 0 and close < macroSma)
    strategy.close("Exhaustion_Long", comment="Stop: Trend Break")

// 2. Time Stop: reversion thesis dead if TP not reached within N bars
if (strategy.position_size > 0 and timeStopBars > 0 and bar_index - entryBar >= timeStopBars)
    strategy.close("Exhaustion_Long", comment="Stop: Time")

// 3. Entry on Close; take-profit as a resting limit at the frozen mid-band
if (strategy.position_size == 0 and entryCondition)
    targetMid := bbBasis
    entryBar  := bar_index
    strategy.entry("Exhaustion_Long", strategy.long, comment="Enter Position")
    strategy.exit("TP Reversion", "Exhaustion_Long", limit=targetMid)

// --- Visual Chart Layout ---
plot(macroSma, color=color.blue, linewidth=2, title="150 SMA Macro floor")
plot(bbBasis, color=color.orange, title="BB Basis Mean Line")
plot(bbLower, color=color.red, title="BB Lower Boundary")
plot(strategy.position_size > 0 ? targetMid : na, color=color.green, style=plot.style_linebr, linewidth=2, title="Active TP Target")
bgcolor(entryCondition ? color.new(color.green, 85) : na, title="Trigger Zone")